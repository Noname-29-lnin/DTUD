000000a6 <Save_Calib_To_EEPROM>:

float CalADC_cel_aftercalib(uint16_t value_hex){
	int16_t raw = (int16_t)value_hex;
	float temperature = (calib_slope * (float)raw) + calib_offset;
	return temperature;
}
